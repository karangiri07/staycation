DATABASE_URL=postgresql+psycopg://staycation:staycation@localhost:5432/staycation
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRE_MINUTES=60
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-before-deploy
CORS_ORIGINS=http://localhost:5173
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# development on your laptop, production on the live server (weak passwords then stop the server from starting)
APP_ENV=development
# true when the site is behind Render / Nginx / Cloudflare, false when the API is exposed directly
TRUST_PROXY=true
